 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChessBoard {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  userId      String
  createdAt   DateTime  @default(now())
  material    String
  razmer      String?
}
